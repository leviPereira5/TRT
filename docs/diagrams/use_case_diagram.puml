@startuml
left to right direction

actor "Utilizador" as U
actor "API yfinance" as API
actor "ntfy.sh" as NTFY

rectangle "TRT Invest — Financial Market Monitoring System" {

  usecase "Autenticar utilizador" as UC10
  usecase "Gerir ações monitorizadas" as UC01
  usecase "Configurar intervalo\ne tópico ntfy.sh" as UC02
  usecase "Monitorizar ações\n(ciclo automático)" as UC09
  usecase "Consultar cotação" as UC04
  usecase "Enviar notificação push" as UC06
  usecase "Evitar notificações\nduplicadas" as UC08
  usecase "Registar histórico\nde alertas" as UC07

}

' Utilizador
U --> UC10
U --> UC01
U --> UC02

' Sistema inicia monitorização
UC09 ..> UC04 : <<include>>
UC09 ..> UC06 : <<extend>>

' Notificação
UC06 ..> UC08 : <<include>>
UC06 ..> UC07 : <<include>>

' Externas
UC04 --> API
UC06 --> NTFY

@enduml
